<%- include('_top') %>
<h2>Dashboard</h2>
<p>Welcome, <strong><%= buyer.name || buyer.email %></strong></p>

<div class="grid">
  <div class="card">
    <h3>Usage this month</h3>
    <p><strong><%= monthLeadCount %></strong> leads</p>
    <p>Estimated bill: $<%= monthLeadCount * pricePerLead %></p>
  </div>
  <div class="card">
    <h3>Your API Key</h3>
    <pre><%= buyer.api_key %></pre>
    <p class="text-muted">Send this in the <code>x-api-key</code> header.</p>
  </div>
</div>

<h3>Send a lead</h3>
<pre>curl -X POST <%= appUrl %>/api/leads \
  -H "Content-Type: application/json" \
  -H "x-api-key: <%= buyer.api_key %>" \
  -d '{
    "name": "Jane Prospect",
    "email": "jane@example.com",
    "phone": "+1-555-555-5555",
    "meta": { "source": "website", "vertical": "Roofing" }
  }'
</pre>

<p class="text-muted">We increment your Stripe metered usage for each accepted lead. Duplicates/spam should be adjusted via support.</p>
<%- include('_bottom') %>